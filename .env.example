# Required only for the real product. Keep the actual key in ignored local .env.
OPENAI_API_KEY=

# Canonical real-product mode. npm run hero and npm run demo explicitly use
# their isolated sandbox configurations instead.
BANDER_RUNTIME_MODE=real

# Required for real Google Calendar. Create a Desktop OAuth client, download it
# under ignored .bander/, and let Bander write the token to the second path.
# Bander requests only calendar.events.owned and fixes the Calendar to primary.
GOOGLE_OAUTH_CLIENT_PATH=.bander/google-oauth-client.json
GOOGLE_OAUTH_TOKEN_PATH=.bander/google-oauth-token.json

# Required separately for bounded Gmail reading and exact approved replies.
# This token requests only gmail.readonly and gmail.send. Keep it distinct from
# the Calendar token so neither credential silently broadens the other.
GMAIL_OAUTH_CLIENT_PATH=.bander/gmail-oauth-client.json
GMAIL_OAUTH_TOKEN_PATH=.bander/gmail-oauth-token.json

# Use the connected Calendar's IANA timezone. America/Denver is the verified
# Build Week filming configuration, not a claim of universal timezone testing.
BANDER_CALENDAR_TIME_ZONE=America/Denver

# Optional sanitized evidence-probe inputs. They are not used by npm run real.
BANDER_GOOGLE_EVENT_TITLE_HINT=
BANDER_GOOGLE_EVENT_LOCAL_DATE=
BANDER_GOOGLE_TARGET_LOCAL_TIME=
BANDER_SOL_EVIDENCE_REQUEST=

# Required for real product and real Telegram verification. Use two distinct
# BotFather bots and keep the real values only in ignored local .env.
OPENCLAW_TELEGRAM_BOT_TOKEN=
BANDER_TELEGRAM_BOT_TOKEN=

# Local-only service ports. Change only if these ports are already occupied.
BANDER_PORT=4310
MOCK_SERVICE_PORT=4311
WEB_PORT=4312
