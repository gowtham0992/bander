{
  "agents": {
    "defaults": {
      "workspace": ".bander/openclaw-workspace",
      "model": {
        "primary": "bander-mock/reference-model"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "bander-mock": {
        "baseUrl": "http://127.0.0.1:4313/v1",
        "apiKey": "bander-local-verification",
        "api": "openai-completions",
        "models": [
          {
            "id": "reference-model",
            "name": "Bander deterministic OpenClaw verifier",
            "reasoning": false,
            "input": ["text"],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 32000,
            "maxTokens": 1000
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "allow": [
      "bander__list_capabilities",
      "bander__propose_action",
      "bander__get_receipt"
    ]
  },
  "mcp": {
    "servers": {
      "bander": {
        "url": "http://localhost:4310/mcp",
        "transport": "streamable-http",
        "connectTimeout": 5,
        "timeout": 20,
        "supportsParallelToolCalls": false,
        "toolFilter": {
          "include": [
            "list_capabilities",
            "propose_action",
            "get_receipt"
          ]
        }
      }
    }
  }
}
