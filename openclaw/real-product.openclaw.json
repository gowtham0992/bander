{
  "agents": {
    "defaults": {
      "workspace": ".bander/openclaw-workspace",
      "model": {
        "primary": "bander-openai/gpt-5.6-sol"
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "bander-openai": {
        "baseUrl": "https://api.openai.com/v1",
        "apiKey": "${OPENAI_API_KEY}",
        "api": "openai-responses",
        "models": [
          {
            "id": "gpt-5.6-sol",
            "name": "GPT-5.6 Sol for protected OpenClaw",
            "reasoning": true,
            "input": ["text"],
            "contextWindow": 400000,
            "maxTokens": 128000
          }
        ]
      }
    }
  },
  "tools": {
    "profile": "full",
    "allow": [
      "bander__list_capabilities",
      "bander__read_schedule",
      "bander__read_inbox",
      "bander__propose_action",
      "bander__get_receipt"
    ]
  },
  "mcp": {
    "servers": {
      "bander": {
        "url": "http://localhost:4310/mcp",
        "transport": "streamable-http",
        "connectTimeout": 5,
        "timeout": 20,
        "supportsParallelToolCalls": false,
        "toolFilter": {
          "include": [
            "list_capabilities",
            "read_schedule",
            "read_inbox",
            "propose_action",
            "get_receipt"
          ]
        }
      }
    }
  }
}
